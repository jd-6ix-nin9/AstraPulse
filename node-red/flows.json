    {
        "id": "eb88ee52dc177bdf",
        "type": "function",
        "z": "803b7ab6696fae80",
        "name": "System Status",
        "func": "let t = msg.payload.temperature;\nlet a = msg.payload.acceleration;\nlet g = msg.payload.gyro;\n\nlet thermal = \"\";\nlet motion = \"\";\nlet attitude = \"\";\n\n// Temperature\nif (t < 50) thermal = \"THERMAL NOMINAL\";\nelse if (t < 60) thermal = \"THERMAL RISE\";\nelse thermal = \"THERMAL BREACH\";\n\n// Acceleration\nif (a < 11.772) motion = \"MOTION STABLE\";\nelse if (a < 14.715) motion = \"MOTION DISTURBANCE\";\nelse motion = \"MOTION TURBULENCE\";\n\n// Gyro\nif (g <= 0.087) attitude = \"ATTITUDE LOCKED\";\nelse if (g <= 0.524) attitude = \"ATTITUDE DRIFT\";\nelse attitude = \"ATTITUDE LOSS\";\n\nmsg.payload = thermal + \" / \" + motion + \" / \" + attitude;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 400,
        "wires": [
