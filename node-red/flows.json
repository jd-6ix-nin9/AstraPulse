        "z": "803b7ab6696fae80",
        "name": "Gyro Predictor",
        "func": "let alpha = 0.6;\n\nlet hist = context.get(\"hist\") || { x: [], y: [], z: [] };\n\nfunction update(arr, val) {\n    arr.push(val);\n    if (arr.length > 10) arr.shift();\n    return arr;\n}\n\nhist.x = update(hist.x, msg.payload.x);\nhist.y = update(hist.y, msg.payload.y);\nhist.z = update(hist.z, msg.payload.z);\n\ncontext.set(\"hist\", hist);\n\nfunction ewma(arr) {\n    let s = arr[0];\n    for (let i = 1; i < arr.length; i++) {\n        s = alpha * arr[i] + (1 - alpha) * s;\n    }\n    return s;\n}\n\nlet prev = context.get(\"prev\") || { x: 0, y: 0, z: 0 };\n\nlet smooth = {\n    x: ewma(hist.x),\n    y: ewma(hist.y),\n    z: ewma(hist.z)\n};\n\ncontext.set(\"prev\", smooth);\n\n// gyro threshold\nlet threshold = 0.5;\n\nfunction analyze(s, p, curr) {\n    let trend = s - p;\n    let spike = Math.abs(curr - p) > 0.2;\n\n    if (s >= threshold) return \"🔥 Instability NOW\";\n\n    if (spike && trend > 0) return \"⚠️ Sudden spike\";\n\n    if (Math.abs(trend) < 0.005) return \"Stable\";\n\n    let time = (threshold - s) / trend;\n\n    if (time > 0 && time < 120)\n        return \"⚠️ Instability in ~\" + Math.round(time) + \"s\";\n\n    return \"Stable\";\n}\n\nlet px = analyze(smooth.x, prev.x, msg.payload.x);\nlet py = analyze(smooth.y, prev.y, msg.payload.y);\nlet pz = analyze(smooth.z, prev.z, msg.payload.z);\n\nmsg.payload =\n    \"GYRO Prediction:\\nX: \" + px +\n    \"\\nY: \" + py +\n    \"\\nZ: \" + pz;\n\nreturn msg;",
