    {
        "id": "9d235f504dc10503",
        "type": "function",
        "z": "803b7ab6696fae80",
        "name": "Risk Func",
        "func": "let t = msg.payload.temperature;\n\nlet ax = msg.payload.acc_x;\nlet ay = msg.payload.acc_y;\nlet az = msg.payload.acc_z;\n\nlet gx = msg.payload.gyro_x;\nlet gy = msg.payload.gyro_y;\nlet gz = msg.payload.gyro_z;\n\n// 🔹 Magnitudes\nlet acc = Math.sqrt(ax * ax + ay * ay + az * az);\nlet gyro = Math.sqrt(gx * gx + gy * gy + gz * gz);\n\n// 🔹 Normalize (based on your limits)\nlet tempScore = Math.min((t / 60) * 100, 100);\nlet accScore = Math.min((acc / 14.7) * 100, 100);\nlet gyroScore = Math.min((gyro / 0.5) * 100, 100);\n\n// 🔹 Weighted risk score\nlet risk = (0.5 * tempScore) + (0.25 * accScore) + (0.25 * gyroScore);\n\n// 🔹 Status (optional, for debug/dashboard text)\nlet status = \"\";\n\nif (risk < 60) status = \"SAFE\";\nelse if (risk < 80) status = \"MODERATE\";\nelse status = \"CRITICAL\";\n\n// 🔹 OUTPUT FOR GAUGE\nmsg.payload = Math.round(risk);   // or risk.toFixed(2)\n\nmsg.status = status; // optional if you want to show it elsewhere\n\nreturn msg;",
