    {
        "id": "4d3a465a74fa0aa0",
        "type": "function",
        "z": "803b7ab6696fae80",
        "name": "CSV Function",
        "func": "let t = msg.payload.temperature;\nlet ax = msg.payload.acc_x;\nlet ay = msg.payload.acc_y;\nlet az = msg.payload.acc_z;\nlet gx = msg.payload.gyro_x;\nlet gy = msg.payload.gyro_y;\nlet gz = msg.payload.gyro_z;\nlet avg_accn = msg.payload.acceleration;\nlet avg_gyro = msg.payload.gyro\n\nmsg.payload = t + \",\" + ax + \",\" + ay + \",\" + az + \",\" + gx + \",\" + gy + \",\" + gz + \",\" + avg_accn + \",\" + avg_gyro + \"\\n\" ;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 600,
        "y": 720,
        "wires": [
            [
                "272cfae9d1f57026"
            ]
        ]
    },
    {
        "id": "c8d3095f334f45a7",
        "type": "function",
        "z": "803b7ab6696fae80",
        "name": "Temp. Predictor",
        "func": "let alpha = 0.6;\n\n// get history (last 10)\nlet hist = context.get(\"hist\") || [];\n\n// add current\nhist.push(msg.payload);\nif (hist.length > 10) hist.shift();\n\ncontext.set(\"hist\", hist);\n\n// compute EWMA over window\nlet smooth = hist[0];\n\nfor (let i = 1; i < hist.length; i++) {\n    smooth = alpha * hist[i] + (1 - alpha) * smooth;\n}\n\n// previous smooth (for trend)\nlet prevSmooth = context.get(\"prevSmooth\") || smooth;\ncontext.set(\"prevSmooth\", smooth);\n\n// trend\nlet trend = smooth - prevSmooth;\n\n// spike detection\nlet curr = msg.payload;\nlet spike = Math.abs(curr - prevSmooth) > 5;\n\n// prediction\nlet target = 60;\n\nif (Math.abs(trend) < 0.01) {\n    msg.payload = \"Temp stable\";\n    return msg;\n}\n\nlet time = (target - smooth) / trend;\n\n// output\nif (smooth >= target) {\n    msg.payload = \"🔥 Temp already above 60°C\";\n}\nelse if (spike && trend > 0) {\n    msg.payload = \"⚠️ Sudden spike detected!\";\n}\nelse if (time > 0 && time < 120) {\n    msg.payload = \"⚠️ Temp likely to cross 60°C in ~\" + Math.round(time) + \"s\";\n}\nelse {\n    msg.payload = \"Temp stable\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 880,
        "y": 200,
        "wires": [
            [
                "2516dd27cd6e4a2c"
            ]
        ]
    },
    {
        "id": "2df19459434ec73d",
        "type": "function",
        "z": "803b7ab6696fae80",
        "name": "Acc. Predictor",
        "func": "let alpha = 0.6;\n\n// get history\nlet hist = context.get(\"hist\") || {x:[], y:[], z:[]};\n\n// update function\nfunction update(arr, val){\n    arr.push(val);\n    if(arr.length > 10) arr.shift();\n    return arr;\n}\n\n// update history\nhist.x = update(hist.x, msg.payload.x);\nhist.y = update(hist.y, msg.payload.y);\nhist.z = update(hist.z, msg.payload.z);\n\ncontext.set(\"hist\", hist);\n\n// EWMA over window\nfunction ewma(arr){\n    let s = arr[0];\n    for(let i=1;i<arr.length;i++){\n        s = alpha * arr[i] + (1-alpha)*s;\n    }\n    return s;\n}\n\n// previous smooth\nlet prev = context.get(\"prev\") || {x:0,y:0,z:0};\n\n// current smooth\nlet smooth = {\n    x: ewma(hist.x),\n    y: ewma(hist.y),\n    z: ewma(hist.z)\n};\n\ncontext.set(\"prev\", smooth);\n\n// threshold (~1.5g)\nlet threshold = 14.7;\n\n// analysis\nfunction analyze(s, p, curr){\n    let trend = s - p;\n    let spike = Math.abs(curr - p) > 5;\n\n    if (s >= threshold) return \"🔥 Turbulence NOW\";\n\n    if (spike && trend > 0) return \"⚠️ Sudden spike\";\n\n    if (Math.abs(trend) < 0.01) return \"Stable\";\n\n    let time = (threshold - s) / trend;\n\n    if (time > 0 && time < 120)\n        return \"⚠️ Turbulence in ~\" + Math.round(time) + \"s\";\n\n    return \"Stable\";\n}\n\nlet px = analyze(smooth.x, prev.x, msg.payload.x);\nlet py = analyze(smooth.y, prev.y, msg.payload.y);\nlet pz = analyze(smooth.z, prev.z, msg.payload.z);\n\nmsg.payload =\n\"ACC Prediction:\\nX: \" + px +\n\"\\nY: \" + py +\n\"\\nZ: \" + pz;\n\nreturn msg;",
